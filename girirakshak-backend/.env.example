PORT=5000

# Leave MONGO_URI unset to run on the built-in in-memory data store (no setup
# needed — great for local dev/demo). Set it to a real connection string
# (e.g. a free MongoDB Atlas cluster) to persist real data, then run:
#   npm run seed
MONGO_URI=

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
